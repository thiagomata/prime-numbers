{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "just verify": "allow",
      "just *": "allow",
      "sbt *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "git status": "allow",
      "git diff": "allow",
      "git log *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git checkout *": "deny",
      "git revert *": "deny",
      "git push --force *": "deny",
      "rm *": "deny"
    },
    "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny" },
    "doom_loop": "ask"
  }
}
